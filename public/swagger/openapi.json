    "/events/view/{id}/click": {
      "post": {
        "tags": [
          "Events"
        ],
        "summary": "Record event click",
        "description": "Record a click/view for an event",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Click recorded successfully"
          }
        }
      }
    },
    "/events/trending": {
      "get": {
        "tags": [
          "Events"
        ],
        "summary": "Get trending events",
        "description": "Retrieve a list of trending events",
        "responses": {
          "200": {
            "description": "List of trending events",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Event"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/events/feed": {
      "get": {
        "tags": [
          "Events"
        ],
        "summary": "Get events feed",
        "description": "Retrieve a personalized feed of events including trending, nearby, and personalized feed",
        "responses": {
          "200": {
            "description": "Events feed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "trending": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Event"
                      },
                      "description": "Array of trending events"
                    },
                    "nearMe": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Event"
                      },
                      "description": "Array of events near the user"
                    },
                    "feed": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Event"
                      },
                      "description": "Array of personalized feed events"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/ticketTypes": {
      "get": {
        "tags": [
          "Ticket Types"
        ],
        "summary": "List ticket types",
        "description": "Get all available ticket types",
        "responses": {
          "200": {
            "description": "List of ticket types",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TicketType"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/ticketTypes/view/{id}": {
      "get": {
        "tags": [
          "Ticket Types"
        ],
        "summary": "Get ticket type by ID",
        "description": "Retrieve details of a specific ticket type",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Ticket type details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TicketType"
                }
              }
            }
          }
        }
      }
    },
    "/ticketTypes/action": {
      "post": {
        "tags": [
          "Ticket Types"
        ],
        "summary": "Create ticket type",
        "description": "Create a new ticket type",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TicketTypeRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Ticket type created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TicketType"
                }
              }
            }
          }
        }
      }
    },
    "/tickets": {
      "get": {
        "tags": [
          "Tickets"
        ],
        "summary": "List tickets",
        "description": "Get all tickets",
        "responses": {
          "200": {
            "description": "List of tickets",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Ticket"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/tickets/view/{id}": {
      "get": {
        "tags": [
          "Tickets"
        ],
        "summary": "Get ticket by ID",
        "description": "Retrieve details of a specific ticket",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Ticket details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Ticket"
                }
              }
            }
          }
        }
      }
    },
    "/tickets/action": {
      "post": {
        "tags": [
          "Tickets"
        ],
        "summary": "Create ticket",
        "description": "Create a new ticket",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TicketRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Ticket created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Ticket"
                }
              }
            }
          }
        }
      }
    },
    "/tickets/buy": {
      "post": {
        "tags": [
          "Tickets"
        ],
        "summary": "Purchase ticket",
        "description": "Complete ticket purchase with payment processing",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TicketPurchaseRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Purchase initiated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentResponse"
                }
              }
            }
          }
        }
      }
    },
    "/qr": {
      "get": {
        "tags": [
          "QR"
        ],
        "summary": "Generate QR code",
        "description": "Generate QR code for ticket",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QREncryptRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "QR code data",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "qrData": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "QR"
        ],
        "summary": "Decrypt QR data",
        "description": "Decrypt QR code data for ticket validation",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QRDecryptRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Decrypted ticket data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Ticket"
                }
              }
            }
          }
        }
      }
    },
    "/mail": {
      "get": {
        "tags": [
          "Mail"
        ],
        "summary": "Send mail",
        "description": "Send an email",
        "responses": {
          "200": {
            "description": "Mail sent successfully"
          }
        }
      }
    },
    "/": {
      "get": {
        "tags": [
          "Welcome"
        ],
        "summary": "Welcome endpoint",
        "description": "Get welcome message",
        "responses": {
          "200": {
            "description": "Welcome message",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "LoginRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "user@example.com"
          },
          "password": {
            "type": "string",
            "example": "securePassword123"
          }
        }
      },
      "SignupRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "user@example.com"
          },
          "password": {
            "type": "string",
            "example": "securePassword123"
          }
        }
      },
      "AuthResponse": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/User"
          }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "username": {
            "type": "string"
          },
          "bio": {
            "type": "string"
          },
          "avatar": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Event": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "format": "date-time"
          },
          "categories": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "ticketType": {
            "$ref": "#/components/schemas/TicketType"
          }
        }
      },
      "EventRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "format": "date-time"
          },
          "categories": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "ticketType": {
            "type": "string"
          }
        }
      },
      "TicketType": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "price": {
            "type": "number"
          },
          "description": {
            "type": "string"
          }
        }
      },
      "TicketTypeRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "price": {
            "type": "number"
          },
          "description": {
            "type": "string"
          }
        }
      },
      "TicketPurchaseRequest": {
        "type": "object",
        "properties": {
          "ticketRequest": {
            "type": "object",
            "properties": {
              "event": {
                "type": "string"
              },
              "ticketType": {
                "type": "string"
              },
              "issuedTo": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "phone": {
                    "type": "string"
                  },
                  "email": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "paymentRequest": {
            "type": "object",
            "properties": {
              "gateway": {
                "type": "string",
                "enum": [
                  "sckaler"
                ]
              },
              "provider": {
                "type": "string",
                "enum": [
                  "moov"
                ]
              },
              "country": {
                "type": "string"
              },
              "tel": {
                "type": "string"
              },
              "amount": {
                "type": "number"
              },
              "description": {
                "type": "string"
              },
              "currency": {
                "type": "string",
                "enum": [
                  "XOF"
                ]
              }
            }
          }
        }
      },
      "PaymentResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "paymentUrl": {
            "type": "string"
          }
        }
      },
      "QREncryptRequest": {
        "type": "object",
        "properties": {
          "keyWord": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "email": {
                "type": "string"
              },
              "ticketNumber": {
                "type": "string"
              }
            }
          }
        }
      },
      "QRDecryptRequest": {
        "type": "object",
        "properties": {
          "keyWord": {
            "type": "string"
          }
        }
      },
      "Ticket": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "event": {
            "$ref": "#/components/schemas/Event"
          },
          "ticketType": {
            "$ref": "#/components/schemas/TicketType"
